# Скопируйте этот файл в .env и подставьте свои значения.
# Файл .env в Git НЕ коммитится (см. .gitignore).
POSTGRES_USER=recipe_user
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=recipe_book

# Адреса frontend, которым разрешены запросы к API (JSON-список)
CORS_ORIGINS=["http://localhost:5173"]

# Секрет для подписи JWT (минимум 32 символа). Сгенерируйте свой:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace_me_with_a_long_random_string_at_least_32_chars
JWT_ALGORITHM=HS256
# Срок жизни access-токена (минуты) и refresh-токена (дни)
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
